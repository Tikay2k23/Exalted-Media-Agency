// Quality assurance, client review, and revision control.

enum QaPlanStatus {
  DRAFT
  READY
  IN_PROGRESS
  PASSED
  FAILED
  BLOCKED
}

enum QaTestStatus {
  NOT_RUN
  PASSED
  FAILED
  BLOCKED
  SKIPPED
  RETEST_REQUIRED
}

enum DefectSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum DefectStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  READY_FOR_RETEST
  REOPENED
  PASSED
  CLOSED
  BLOCKED
  WONT_FIX
}

enum ReviewStatus {
  PREPARING
  SENT
  AWAITING_FEEDBACK
  FEEDBACK_RECEIVED
  REVISIONS_IN_PROGRESS
  APPROVED
  REJECTED
}

/// SOP section 17. Categorising feedback is what keeps included revisions
/// separate from scope changes that should be quoted.
enum FeedbackCategory {
  DEFECT
  FACTUAL_CORRECTION
  INCLUDED_REVISION
  PREFERENCE
  ENHANCEMENT
  SCOPE_CHANGE
  QUESTION
  REJECTED
}

enum RevisionStatus {
  LOGGED
  APPROVED_FOR_WORK
  IN_PROGRESS
  READY_FOR_QA
  COMPLETE
  DECLINED
  DEFERRED
}

enum ApprovalType {
  STRATEGY_BRIEF
  DELIVERABLE
  LAUNCH
  SCOPE_CHANGE
  FINAL_SIGN_OFF
}

model QaPlan {
  id          String       @id @default(cuid())
  clientId    String
  projectId   String?
  name        String
  deliverable String
  status      QaPlanStatus @default(DRAFT)
  ownerId     String?
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner   User?    @relation("QaPlanOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tests   QaTest[]
  defects Defect[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

model QaTest {
  id             String       @id @default(cuid())
  planId         String
  position       Int          @default(0)
  objective      String
  steps          String
  expectedResult String
  actualResult   String?
  status         QaTestStatus @default(NOT_RUN)
  testerId       String?
  evidenceUrl    String?
  executedAt     DateTime?
  retestRequired Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  plan   QaPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  tester User?  @relation("QaTester", fields: [testerId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([status])
}

model Defect {
  id               String         @id @default(cuid())
  clientId         String
  projectId        String?
  planId           String?
  /// Human-facing reference, e.g. DEF-000123.
  reference        String         @unique
  title            String
  deliverable      String?
  severity         DefectSeverity @default(MEDIUM)
  status           DefectStatus   @default(NEW)
  description      String
  stepsToReproduce String?
  expectedResult   String?
  actualResult     String?
  evidenceUrl      String?
  raisedById       String?
  assignedToId     String?
  /// Who verified the fix. The SOP requires this to be someone other than the
  /// person who did the work, unless an authorized override is recorded.
  verifiedById     String?
  dueDate          DateTime?
  correctionNotes  String?
  retestResult     String?
  closedAt         DateTime?
  /// Set when a defect was closed without independent verification.
  closureOverrideReason String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  plan       QaPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  raisedBy   User?    @relation("DefectReporter", fields: [raisedById], references: [id], onDelete: SetNull)
  assignedTo User?    @relation("DefectAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  verifiedBy User?    @relation("DefectVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([severity])
  @@index([assignedToId])
  @@index([dueDate])
}

model ReviewCycle {
  id               String       @id @default(cuid())
  clientId         String
  projectId        String?
  /// 1 for the first review, incrementing per round.
  roundNumber      Int          @default(1)
  status           ReviewStatus @default(PREPARING)
  reviewLink       String?
  walkthroughLink  String?
  sentAt           DateTime?
  feedbackDeadline DateTime?
  feedbackReceivedAt DateTime?
  approverContactId String?
  ownerId          String?
  summary          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  approverContact ClientContact? @relation("ReviewApprover", fields: [approverContactId], references: [id], onDelete: SetNull)
  owner           User?          @relation("ReviewOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  revisions       RevisionItem[]

  @@unique([clientId, projectId, roundNumber])
  @@index([clientId])
  @@index([status])
  @@index([feedbackDeadline])
}

model RevisionItem {
  id             String           @id @default(cuid())
  reviewCycleId  String
  reference      String           @unique
  clientComment  String
  category       FeedbackCategory @default(INCLUDED_REVISION)
  approvedAction String?
  status         RevisionStatus   @default(LOGGED)
  assignedToId   String?
  dueDate        DateTime?
  completionEvidence String?
  qaVerified     Boolean          @default(false)
  clientAccepted Boolean          @default(false)
  /// Set when the item is a scope change that carries a fee.
  additionalCost Decimal?         @db.Decimal(12, 2)
  timelineImpactDays Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  reviewCycle ReviewCycle @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  assignedTo  User?       @relation("RevisionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([reviewCycleId])
  @@index([status])
  @@index([category])
  @@index([assignedToId])
}

/// A recorded client sign-off. Launch gates read this table.
model Approval {
  id             String       @id @default(cuid())
  clientId       String
  projectId      String?
  type           ApprovalType
  subject        String
  /// Who at the client approved, and how it was captured.
  approverContactId String?
  approvedByName String?
  evidenceUrl    String?
  approvedAt     DateTime     @default(now())
  recordedById   String?
  notes          String?
  createdAt      DateTime     @default(now())

  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  approverContact ClientContact? @relation("ApprovalContact", fields: [approverContactId], references: [id], onDelete: SetNull)
  recordedBy      User?          @relation("ApprovalRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([clientId, type])
  @@index([projectId])
  @@index([approvedAt])
}
