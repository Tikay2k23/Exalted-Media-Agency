// Projects, work items, and weekly accountability.

enum ProjectStatus {
  PLANNING
  IN_PRODUCTION
  INTERNAL_QA
  CLIENT_REVIEW
  REVISIONS
  READY_FOR_LAUNCH
  LIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum RiskLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Existing values are preserved so historical work items keep their meaning:
/// TODO reads as "not started" and DONE as "complete".
/// Where a piece of work is.
///
/// One vocabulary for the whole app: the assignment form, the weekly tracker
/// and the dashboards all read from this, so a status cannot exist on one
/// screen and not another.
enum EmployeeTaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  WAITING_CLIENT
  BLOCKED
  NEEDS_REVIEW
  REVISION_REQUIRED
  APPROVED
  DONE
  /// Not offered as a starting status - work is never created cancelled - but
  /// kept because closing something down is a real thing that happens.
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

/// What kind of work this is.
///
/// Two groups, and the difference matters.
///
/// The first eighteen are the marketing work somebody assigns: they drive the
/// specialist recommendation and the guidance panel on the assignment form.
///
/// The rest are lifecycle categories generated by stage automation. Five stage
/// gates read them by name - onboarding, strategy, quality assurance, revision
/// and launch - so they are not up for renaming. They are deliberately absent
/// from the assignment form, because they are the system's own bookkeeping
/// rather than a choice anybody makes.
enum TaskCategory {
  CONTENT_PLANNING
  COPYWRITING
  CREATIVE_DESIGN
  VIDEO_PRODUCTION
  PAID_MEDIA
  SEO
  SOCIAL_MEDIA
  EMAIL_AND_SMS_MARKETING
  CRM_AND_AUTOMATION
  FUNNELS_AND_LANDING_PAGES
  WEBSITE_UPDATES
  LEAD_GENERATION_AND_OUTREACH
  ANALYTICS_AND_TRACKING
  CLIENT_REPORTING
  REPUTATION_MANAGEMENT
  INTEGRATIONS
  CLIENT_MANAGEMENT
  INTERNAL_OPERATIONS

  // Lifecycle. Generated by automation, read by the stage gates.
  ONBOARDING
  STRATEGY
  QUALITY_ASSURANCE
  REVISION
  LAUNCH
  CLIENT_TRAINING
  RENEWAL
  OFFBOARDING
  AUDIT
}

/// Where the work happens. Free-form would give us "meta", "Meta Ads", "FB"
/// and no way to report on any of it.
enum TaskPlatform {
  META_ADS
  GOOGLE_ADS
  GOHIGHLEVEL
  WEBSITE
  EMAIL
  SMS
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  GOOGLE_BUSINESS_PROFILE
  YOUTUBE
  TIKTOK
  CANVA
  ZAPIER
  MAKE
  N8N
  OTHER
}

enum TaskRecurrence {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

model Project {
  id             String        @id @default(cuid())
  clientId       String
  name           String
  serviceType    ServiceType
  projectManagerId String?
  status         ProjectStatus @default(PLANNING)
  health         HealthStatus  @default(NOT_ASSESSED)
  riskLevel      RiskLevel     @default(NONE)
  startDate      DateTime?
  dueDate        DateTime?
  targetLaunchDate DateTime?
  progressPercent Int          @default(0)
  budgetedHours  Int?
  clientDependency String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  client         Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectManager User?  @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  milestones     Milestone[]
  workItems      EmployeeTask[]
  qaPlans        QaPlan[]
  defects        Defect[]
  reviewCycles   ReviewCycle[]
  approvals      Approval[]
  launches       Launch[]

  @@index([clientId])
  @@index([projectManagerId])
  @@index([status])
  @@index([targetLaunchDate])
  @@index([deletedAt])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([dueDate])
}

/// The agency work item. Named EmployeeTask for continuity with existing data
/// and its end-of-day entries; presented as "Work Item" in the interface.
model EmployeeTask {
  id             String             @id @default(cuid())
  title          String
  note           String?
  status         EmployeeTaskStatus @default(TODO)
  priority       TaskPriority       @default(MEDIUM)
  dueDate        DateTime
  assignedToId   String
  createdById    String?
  clientId       String?
  /// Set when the task belongs to an open opportunity rather than a signed
  /// client. Added so "Add task" on an opportunity uses this table instead of
  /// growing a second, parallel task system that no report would ever see.
  leadId         String?
  projectId      String?
  reviewerId     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  category       TaskCategory       @default(INTERNAL_OPERATIONS)
  estimatedHours Int                @default(2)
  actualHours    Int?
  weekStartDate  DateTime           @default(now())
  department     Department?
  blocker        String?
  isClientFacing Boolean            @default(false)
  completionCriteria String?
  evidenceUrl    String?
  requiresApproval Boolean          @default(false)
  requiresQa     Boolean            @default(false)

  /// Where the work happens, and what it is for.
  platform       TaskPlatform?
  objective      String?
  /// Links to briefs, drives, boards. Never credentials - the access register
  /// holds those, and it has no password field by design.
  requiredAssets String?
  /// How success is judged, in the client's terms rather than "done".
  kpi            String?
  startDate      DateTime?
  recurrence     TaskRecurrence     @default(NONE)
  completedAt    DateTime?
  deletedAt      DateTime?

  /// When the assignee handed it over. Cleared on a revision request, because
  /// resubmitting is a new hand-over and the reviewer's clock restarts.
  submittedAt    DateTime?
  /// Who signed it off, and when. Separate from completedAt: approval is a
  /// judgement somebody made, completion is a state the work reached, and a
  /// report that cannot tell them apart cannot answer "who approved this".
  approvedById   String?
  approvedAt     DateTime?
  /// What the reviewer asked for. Kept after the fix so the next reviewer can
  /// see what the last one objected to.
  revisionNote   String?
  /// Out of the active board, still in the history and the reports. Archiving
  /// is not deleting: the row stays, the queries stop counting it as work.
  archivedAt     DateTime?
  archivedById   String?

  /// Which template generated this, if one did.
  ///
  /// Stage automation runs again every time a client re-enters a stage, and a
  /// client moved back for a revision would otherwise collect a second copy of
  /// every task that stage creates. Unique per client, so generating twice is
  /// harmless. Null for anything a person typed, and many rows may be null -
  /// Postgres does not treat nulls as equal in a unique index.
  templateKey    String?

  assignedTo User                   @relation("EmployeeTaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  client     Client?                @relation(fields: [clientId], references: [id])
  lead       Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy  User?                  @relation("EmployeeTaskCreator", fields: [createdById], references: [id])
  reviewer   User?                  @relation("EmployeeTaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  approvedBy User?                  @relation("EmployeeTaskApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  archivedBy User?                  @relation("EmployeeTaskArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  project    Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  eodEntries EmployeeTaskEodEntry[]
  comments   TaskComment[]
  blockedBy  TaskDependency[]       @relation("DependentTask")
  blocking   TaskDependency[]       @relation("PrerequisiteTask")

  journeyFlags ClientJourneyFlag[]

  @@index([assignedToId])
  @@index([createdById])
  @@index([clientId])
  @@index([leadId])
  @@index([status])
  @@index([dueDate])
  @@index([weekStartDate])
  @@index([projectId])
  @@index([reviewerId])
  @@index([deletedAt])
  @@index([archivedAt])
  @@index([approvedById])
  @@unique([clientId, templateKey])
}

/// Talking about one piece of work, on the piece of work.
///
/// Deliberately not a messaging system. A thread that lives beside the task it
/// is about is one somebody reads when they pick the task up; a separate inbox
/// is one they read on Monday.
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  /// Set when the comment is the reviewer's reason for sending work back, so
  /// the thread shows why without the reader piecing it together from dates.
  isRevisionNote Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   EmployeeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User         @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([authorId])
}

/// "Task A cannot start until Task B completes."
model TaskDependency {
  id             String   @id @default(cuid())
  dependentTaskId String
  prerequisiteTaskId String
  createdAt      DateTime @default(now())

  dependentTask    EmployeeTask @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  prerequisiteTask EmployeeTask @relation("PrerequisiteTask", fields: [prerequisiteTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, prerequisiteTaskId])
  @@index([dependentTaskId])
  @@index([prerequisiteTaskId])
}

/// One person's end-of-day note on one task, for one day.
///
/// The unique constraint below is what makes a second submission an edit rather
/// than a duplicate: there is exactly one row per person, per task, per date,
/// and pressing submit again updates the one that exists.
model EmployeeTaskEodEntry {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  entryDate DateTime
  summary   String
  blockers  String?
  nextSteps String?
  /// Hours, to the half hour. Float rather than Decimal on purpose - Decimal
  /// does not survive the trip to a client component, which has broken this
  /// app before.
  hoursSpent Float?
  supportNeeded String?

  /// Where the work stood at the end of that day, 0-100. The history of these
  /// is the progress trail a manager reads.
  progressPercent Int?
  /// Somewhere the work can be seen - a page, a doc, a Loom. Never a
  /// credential; the access register holds those and has no password field.
  workLink   String?
  /// The status the task was in when this was written, so the history reads
  /// on its own rather than against a task that has since moved on.
  taskStatus EmployeeTaskStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User         @relation(fields: [authorId], references: [id])
  task   EmployeeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, authorId, entryDate])
  @@index([taskId, entryDate])
  @@index([authorId, entryDate])
}


enum WeeklyReportStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  NEEDS_CHANGES
  APPROVED
}

/// One person's week, compiled from the daily entries they already wrote.
///
/// Deliberately thin. Everything a report says about the work is derived from
/// that week's EOD rows at read time rather than copied in here - a snapshot
/// taken on submission would be wrong the moment somebody corrected a typo in
/// an entry, and there would be two versions of the same week with no way to
/// tell which was true. The only stored prose is the employee's own summary
/// and the reviewer's note.
model WeeklyReport {
  id            String             @id @default(cuid())
  userId        String
  /// Monday of the reporting week, at midnight.
  weekStartDate DateTime
  status        WeeklyReportStatus @default(NOT_STARTED)

  /// The employee's own words, in addition to the compiled work. Optional:
  /// nobody should have to retype what their entries already say.
  summary     String?
  submittedAt DateTime?

  approvedAt   DateTime?
  approvedById String?
  /// Why it was sent back. Kept apart from the summary so a reviewer can never
  /// overwrite what the employee wrote.
  managerNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User  @relation("WeeklyReportAuthor", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("WeeklyReportApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([userId, weekStartDate])
  @@index([weekStartDate, status])
  @@index([userId])
}

/// Small key/value store for things the agency configures once.
///
/// A table rather than an environment variable because the reporting deadline
/// is an operational decision somebody should be able to change without a
/// deploy.
model WorkspaceSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
