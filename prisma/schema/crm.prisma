// Leads, client accounts, and the pipelines they move through.

enum PipelineKind {
  SALES
  FULFILLMENT
}

enum ClientStatus {
  ACTIVE
  AT_RISK
  ON_HOLD
  COMPLETED
}

enum ServiceType {
  SOCIAL_MEDIA_MANAGEMENT
  CONTENT_PRODUCTION
  PAID_ADVERTISING
  BRAND_STRATEGY
  WEBSITE_SUPPORT
  FUNNEL_BUILD
  CRM_AUTOMATION
  SEO
  EMAIL_MARKETING
  FULL_SERVICE_RETAINER
}

enum HealthStatus {
  GREEN
  YELLOW
  RED
  NOT_ASSESSED
}

enum LeadStatus {
  NEW
  ATTEMPTING_CONTACT
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  NURTURE
  CONVERTED
  LOST
  ABANDONED
}

/// Why an opportunity was lost. Coded so it can be counted; the free-text
/// lostReason stays alongside for the detail that does not fit a category.
enum LostReason {
  NO_RESPONSE
  NO_BUDGET
  NOT_INTERESTED
  WENT_WITH_COMPETITOR
  BAD_FIT
  OUTSIDE_SERVICE_AREA
  TIMING
  DUPLICATE_LEAD
  OTHER
}

/// What happened to the strategy call. Booked is a promise; showed is the
/// thing that actually moves a deal.
enum StrategyCallStatus {
  BOOKED
  SHOWED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

enum LeadSource {
  WEBSITE_FORM
  PAID_ADS
  ORGANIC_SEARCH
  SOCIAL_MEDIA
  REFERRAL
  OUTBOUND
  PARTNER
  EVENT
  REPEAT_CLIENT
  OTHER
}

model Pipeline {
  id          String       @id @default(cuid())
  kind        PipelineKind
  name        String
  slug        String       @unique
  description String?
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  stages PipelineStage[]

  @@index([kind])
}

model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  name       String
  slug       String   @unique
  /// Stable machine key used by stage-gate rules and automation, so renaming a
  /// stage in the UI never breaks a workflow.
  stageKey   String?
  color      String
  position   Int
  isDefault  Boolean  @default(false)
  /// Marks an end state such as Won, Lost, or Archived.
  isTerminal Boolean  @default(false)
  /// A retired stage. Still a valid target for accounts that already sit on it,
  /// but hidden from pickers so no new account can be moved into it.
  isDeprecated Boolean @default(false)
  /// Target number of days an account should spend here before it is flagged.
  slaDays    Int?
  description String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pipeline      Pipeline             @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  clients       Client[]
  historiesFrom ClientStageHistory[] @relation("HistoryFromStage")
  historiesTo   ClientStageHistory[] @relation("HistoryToStage")
  requirements  StageRequirement[]
  leads         Lead[]

  @@unique([pipelineId, position])
  @@unique([pipelineId, stageKey])
  @@index([position])
  @@index([pipelineId])
}

/// A condition that must hold before an account may enter a stage.
///
/// Rules live in data rather than code so operations can tighten the process
/// without a deploy. `requirementKey` maps to a checker in
/// lib/journey/stage-requirements.ts.
model StageRequirement {
  id             String   @id @default(cuid())
  stageId        String
  requirementKey String
  label          String
  description    String?
  /// A blocking requirement cannot be passed without a recorded override.
  isBlocking     Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stage PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, requirementKey])
  @@index([stageId])
}

/// A person or company in the sales system.
///
/// Split out from Lead because a Lead is a *deal*, and one relationship can
/// carry several: an account that buys automation this quarter and advertising
/// the next is one contact with two opportunities, not two contacts. Without
/// this, every new deal against a known account forced a duplicate record and
/// the pipeline double-counted the relationship.
///
/// Contact owns the identity. The matching columns on Lead are kept in step by
/// a single writer in lib/sales/contact-service.ts - see the note there for why
/// they still exist.
model Contact {
  id           String    @id @default(cuid())
  name         String
  businessName String
  email        String?
  phone        String?

  /// Normalised match keys: lowercased email, digits-only phone, lowercased
  /// company. Stored rather than computed per query so duplicate detection is
  /// an indexed lookup - the check runs on every lead creation and every
  /// imported row, and a scan with a function over each of them does not hold
  /// up under an import of a few thousand.
  emailKey     String?
  phoneKey     String?
  companyKey   String

  ownerId      String?
  createdById  String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  owner         User?  @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy     User?  @relation("ContactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  opportunities Lead[]

  @@index([emailKey])
  @@index([phoneKey])
  @@index([companyKey])
  @@index([ownerId])
  @@index([deletedAt])
}

/// One opportunity: a potential sale, and everything that happened to it.
///
/// Still called Lead because it is the same row the whole application already
/// reads, and renaming it would have meant rewriting every query for no change
/// in behaviour. `contactId` is what makes it an opportunity rather than a
/// person - several of these may point at one Contact.
model Lead {
  id               String     @id @default(cuid())
  contactId        String?

  /// What this particular deal is for - "CRM Automation", "Website Redesign".
  /// Null on older rows, where the service falls back to the business name.
  opportunityName  String?
  expectedCloseAt  DateTime?
  createdById      String?

  contactName      String
  businessName     String
  email            String?
  phone            String?
  source           LeadSource @default(WEBSITE_FORM)
  serviceInterest  ServiceType?

  /// What this deal is worth before anybody has quoted it. Distinct from
  /// budgetAmount on purpose: what the agency expects to charge and what the
  /// prospect said they could spend are two different facts, and a forecast
  /// built on the second is a forecast of somebody else's opinion.
  opportunityValue Decimal?   @db.Decimal(12, 2)

  budgetAmount     Decimal?   @db.Decimal(12, 2)
  /// The band they answered with, kept verbatim. A range is what people
  /// actually say; budgetAmount is for the times somebody knows the number.
  budgetRange      String?
  timeline         String?
  isDecisionMaker  Boolean?
  mainProblem      String?
  goal             String?
  /// What they are doing about the problem today. Knowing there is an incumbent
  /// changes the sale, so it is asked for and stored rather than left in notes.
  currentSolution  String?
  /// Qualification detail in the rep's own words, kept apart from `notes` so
  /// the general note field does not become the only place anything lands.
  qualificationNotes String?
  /// 0-100 qualification score.
  score            Int?

  /// Where the lead came from, beyond the coarse `source` enum. Optional
  /// throughout: manual entry should never require a UTM.
  campaign         String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  referralSource   String?
  status           LeadStatus @default(NEW)
  stageId          String?
  assignedToId     String?
  proposalValue    Decimal?   @db.Decimal(12, 2)
  proposalSentAt   DateTime?
  decisionDate     DateTime?
  objection        String?
  /// Free text, kept as-is. The coded reason below was added beside it rather
  /// than replacing it, so nothing already written is lost.
  lostReason       String?
  lostReasonCode   LostReason?
  lostAt           DateTime?
  nextFollowUpAt   DateTime?

  /// What happens next, in somebody's own words. Deliberately separate from
  /// nextFollowUpAt: "call the decision maker" and "Thursday at ten" are
  /// different facts, and a pipeline that only stores the date tells you when
  /// to act without telling you what to do.
  nextAction       String?

  /// The last time anybody actually reached this person. Stored rather than
  /// derived from call logs, because an email or a text is contact too and a
  /// lead chased three ways would otherwise read as never contacted.
  lastContactAt    DateTime?

  /// The strategy call, which is the hinge of this pipeline.
  strategyCallAt     DateTime?
  strategyCallStatus StrategyCallStatus?

  /// Recorded on the win, so a converted lead can still answer "who closed
  /// this, when, and for how much" after the client record takes over.
  wonAt            DateTime?
  wonById          String?
  finalValue       Decimal?   @db.Decimal(12, 2)

  /// Nurture is not lost. A date here keeps somebody out of today's follow-up
  /// list without pretending the opportunity is dead.
  nurtureUntil     DateTime?

  /// Custom labels somebody put on this opportunity.
  ///
  /// The automatic stage tag is deliberately NOT stored here. It is derived
  /// from the stage, so it can never disagree with where the deal actually is,
  /// and keeping it out of this array is what makes "remove only the previous
  /// stage tag" true by construction - a stage move cannot touch these.
  tags             String[]  @default([])
  convertedClientId String?   @unique
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  stage           PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  contact         Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  convertedClient Client?        @relation("LeadConversion", fields: [convertedClientId], references: [id], onDelete: SetNull)
  assignedTo      User?          @relation("LeadOwner", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy       User?          @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  wonBy           User?          @relation("LeadCloser", fields: [wonById], references: [id], onDelete: SetNull)
  callLogs        LeadCallLog[]
  leadNotes       LeadNote[]
  followers       LeadFollower[]
  tasks           EmployeeTask[]
  referral        Referral?      @relation("ReferralLead")
  handoff         LeadHandoff?

  @@index([status])
  @@index([assignedToId])
  @@index([contactId])
  @@index([stageId])
  @@index([nextFollowUpAt])
  @@index([source])
  @@index([deletedAt])
  @@index([strategyCallAt])
  @@index([wonAt])
  @@index([proposalSentAt])
  @@index([expectedCloseAt])
}

/// Somebody who wants to know what happens on an opportunity without owning it.
///
/// Separate from `assignedToId` on purpose: an opportunity has exactly one
/// owner who is answerable for it, and any number of followers who are not.
/// Collapsing the two would make "whose deal is this" unanswerable.
model LeadFollower {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  addedById String?
  createdAt DateTime @default(now())

  lead    Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user    User  @relation("LeadFollowing", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User? @relation("LeadFollowerAdder", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([leadId, userId])
  @@index([userId])
}

enum CallOutcome {
  CONNECTED
  NO_ANSWER
  VOICEMAIL
  RESCHEDULED
  NOT_INTERESTED
  CALL_BOOKED
  CALL_SHOWED
  NO_SHOW
}

/// An internal note on a lead.
///
/// The Lead.notes column stays where it is - it holds the qualification detail
/// captured when the lead was created - but it is one text field with no author
/// and no timestamp, so it cannot answer "who said this, and when". This is the
/// running conversation, shaped like TaskComment because it is the same idea
/// applied to a lead.
///
/// Internal only. Nothing here is customer-facing.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation("LeadNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([authorId])
}

model LeadCallLog {
  id              String      @id @default(cuid())
  leadId          String
  loggedById      String?
  outcome         CallOutcome
  notes           String?
  durationMinutes Int?
  occurredAt      DateTime    @default(now())
  createdAt       DateTime    @default(now())

  lead     Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  loggedBy User? @relation("CallLogger", fields: [loggedById], references: [id], onDelete: SetNull)

  @@index([leadId, occurredAt])
  @@index([loggedById])
}

model Client {
  id             String       @id @default(cuid())
  clientName     String
  companyName    String
  contactEmail   String
  contactPhone   String?
  assignedUserId String?
  status         ClientStatus @default(ACTIVE)
  dateAdded      DateTime     @default(now())
  notes          String?
  serviceType    ServiceType
  currentStageId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// When the account entered its current stage. Drives time-in-stage and SLA
  /// reporting without having to walk the full history table.
  stageEnteredAt DateTime     @default(now())
  healthStatus   HealthStatus @default(NOT_ASSESSED)
  /// The seat holding the client right now. Distinct from assignedUserId,
  /// which is the standing account owner: during production the client is
  /// held by a specialist while the project manager still owns the
  /// relationship.
  currentOwnerRole       TeamRole?
  currentOwnerId         String?
  monthlyValue   Decimal?     @db.Decimal(12, 2)
  contractStartDate DateTime?
  contractEndDate   DateTime?
  renewalDate       DateTime?
  currentBlocker    String?
  nextAction        String?
  nextActionDueAt   DateTime?
  lastClientUpdateAt DateTime?
  deletedAt         DateTime?

  assignedUser User?                @relation("ClientAssignee", fields: [assignedUserId], references: [id])
  currentOwner User?                @relation("ClientCurrentOwner", fields: [currentOwnerId], references: [id], onDelete: SetNull)
  currentStage PipelineStage        @relation(fields: [currentStageId], references: [id])
  stageHistory ClientStageHistory[]
  agencyTasks  EmployeeTask[]
  socialTasks  SocialMediaTask[]
  contacts     ClientContact[]
  sourceLead   Lead?                @relation("LeadConversion")
  projects     Project[]

  contracts              Contract[]
  invoices               Invoice[]
  renewals               Renewal[]
  expansionOpportunities ExpansionOpportunity[]
  onboarding             OnboardingRecord?
  accessRecords          AccessRecord[]
  assets                 AssetRecord[]
  strategyBrief          StrategyBrief?
  qaPlans                QaPlan[]
  defects                Defect[]
  reviewCycles           ReviewCycle[]
  approvals              Approval[]
  launches               Launch[]
  incidents              Incident[]
  healthAssessments      ClientHealthAssessment[]
  complaints             Complaint[]
  recoveryPlans          RecoveryPlan[]
  reports                ClientReport[]
  optimizations          Optimization[]
  testimonials           Testimonial[]
  referralsGiven         Referral[]               @relation("ClientReferrals")
  trainingSessions       TrainingSession[]
  offboarding            OffboardingRecord?
  workstreams            ClientWorkstream[]
  intakeForm             IntakeForm?
  handoffs               ClientHandoff[]
  audits                 Audit[]
  salesHandoffs          LeadHandoff[]
  journeyFlags           ClientJourneyFlag[]

  @@index([assignedUserId])
  @@index([status])
  @@index([currentStageId])
  @@index([healthStatus])
  @@index([renewalDate])
  @@index([deletedAt])
}

model ClientContact {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  email       String?
  phone       String?
  role        String?
  isPrimary   Boolean  @default(false)
  isDecisionMaker Boolean @default(false)
  isApprover  Boolean  @default(false)
  communicationPreference String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewCycles ReviewCycle[] @relation("ReviewApprover")
  approvals    Approval[]    @relation("ApprovalContact")

  @@index([clientId])
}

model ClientStageHistory {
  id          String   @id @default(cuid())
  clientId    String
  fromStageId String?
  toStageId   String
  changedById String?
  note        String?
  changedAt   DateTime @default(now())

  /// Set when a blocking stage requirement was bypassed. The reason, approver,
  /// and risk acknowledgement are mandatory at the application layer.
  wasOverridden       Boolean @default(false)
  overrideReason      String?
  overrideApprovedById String?
  overrideRiskAcknowledged Boolean @default(false)
  unmetRequirements   Json?

  changedBy          User?          @relation("StageChangedBy", fields: [changedById], references: [id])
  overrideApprovedBy User?          @relation("StageOverrideApprover", fields: [overrideApprovedById], references: [id], onDelete: SetNull)
  client             Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromStage PipelineStage? @relation("HistoryFromStage", fields: [fromStageId], references: [id])
  toStage   PipelineStage  @relation("HistoryToStage", fields: [toStageId], references: [id])

  @@index([clientId])
  @@index([changedById])
  @@index([changedAt])
  @@index([wasOverridden])
}

model SocialMediaTask {
  id             String           @id @default(cuid())
  clientId       String
  platform       SocialPlatform
  plannedPosts   Int
  completedPosts Int              @default(0)
  dueDate        DateTime
  status         SocialTaskStatus @default(NOT_STARTED)
  assignedUserId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  assignedUser User?  @relation("TaskAssignee", fields: [assignedUserId], references: [id])
  client       Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([assignedUserId])
  @@index([dueDate])
  @@index([status])
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TIKTOK
  X
  YOUTUBE
}

enum SocialTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_ON_CLIENT
  REVIEW
  COMPLETED
}

/// Whether the money for a won deal has actually arrived.
///
/// Deliberately two values. Won and paid are different facts, and the whole
/// point of this handoff is that the delivery team does not start on the first
/// one - a signature is not a payment, and a client placed at "Payment
/// Received" before the payment was received is a record that lies.
enum HandoffPaymentStatus {
  PENDING
  PAID
}

/// Where a won deal has got to on its way into delivery.
enum HandoffState {
  /// Won, but the money has not landed. No client, no journey, no tasks.
  AWAITING_PAYMENT
  /// Paid and being processed right now.
  RUNNING
  /// Client, journey, onboarding and tasks all exist.
  COMPLETED
  /// A step failed. The record says which, and an authorised user may retry.
  FAILED
}

/// The state machine between a won opportunity and a client in delivery.
///
/// This exists because "Won" and "in delivery" are separated by real events -
/// a payment, a duplicate check, a project manager being assigned - and
/// something has to hold that state in between. Before it, the two halves were
/// disconnected: markWon recorded the outcome without starting delivery, and
/// convertLeadToClient started delivery without checking whether the agency
/// already had the account.
///
/// One row per lead, enforced by the unique key on leadId. That single
/// constraint is what makes the handoff idempotent: a double-clicked Confirm,
/// a refresh mid-flight, or a retry after a failure all find the existing row
/// rather than starting a second conversion.
///
/// The per-step timestamps below are not audit decoration. They are what lets a
/// retry resume from the step that failed instead of repeating the ones that
/// succeeded, which is the difference between a safe retry and a duplicate set
/// of onboarding tasks.
model LeadHandoff {
  id       String  @id @default(cuid())
  /// One handoff per opportunity. This is the idempotency key.
  leadId   String  @unique
  /// Set once an account is created or linked. Null while awaiting payment.
  clientId String?

  state HandoffState @default(AWAITING_PAYMENT)

  /// What was agreed, captured at the point of winning rather than
  /// reconstructed later from the proposal.
  serviceType       ServiceType
  finalValue        Decimal?             @db.Decimal(12, 2)
  /// Reuses AgreementStatus rather than inventing a parallel vocabulary for
  /// the same thing the contract register already tracks.
  contractStatus    AgreementStatus      @default(NOT_SENT)
  paymentStatus     HandoffPaymentStatus @default(PENDING)
  expectedStartDate DateTime?
  /// What sales wants delivery to know. Kept apart from the lead's own notes
  /// so the handbook note does not disappear into the sales history.
  handoffNote       String?

  /// Who delivery should go to. Chosen at confirmation, or resolved from the
  /// least-loaded project manager when nobody picks.
  projectManagerId String?

  paymentConfirmedAt   DateTime?
  paymentConfirmedById String?
  completedAt          DateTime?

  /// Per-step progress, so a retry resumes rather than repeats.
  clientLinkedAt      DateTime?
  billingRecordedAt   DateTime?
  onboardingCreatedAt DateTime?
  tasksCreatedAt      DateTime?
  notifiedAt          DateTime?

  /// Set when a step throws. Cleared on the next successful run.
  failedStep     String?
  failureMessage String?
  attemptCount   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead               Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client             Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectManager     User?   @relation("HandoffProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  paymentConfirmedBy User?   @relation("HandoffPaymentConfirmer", fields: [paymentConfirmedById], references: [id], onDelete: SetNull)

  @@index([state])
  @@index([clientId])
  @@index([paymentStatus])
}

/// A temporary condition sitting on top of the journey stage.
///
/// Deliberately not a stage and not a health value. An account waiting on a
/// login is still in Build; pausing for a client's holiday does not undo the
/// work done so far. Before this existed the only way to record any of it was
/// Client.currentBlocker - one free-text field that could hold one thing, with
/// no owner, no date, and no way to say what would clear it.
enum JourneyFlagKind {
  WAITING_ON_CLIENT
  BLOCKED
  REVISIONS_REQUIRED
  PAUSED
}

/// One raised condition, from the moment it is raised until it is cleared.
///
/// Append-only in spirit: resolving sets resolvedAt rather than deleting, so
/// "we lost a week waiting on their agency" is still answerable next quarter.
/// Several may be open at once, because an account genuinely can be both
/// waiting on the client and blocked on something else.
model ClientJourneyFlag {
  id       String          @id @default(cuid())
  clientId String
  kind     JourneyFlagKind

  /// Why it was raised, in the words of whoever raised it.
  reason String
  /// What is actually needed to clear it, or the revision request itself.
  detail String?
  /// Who has to act. Free text rather than a relation: it is often the client,
  /// sometimes their web host, and only sometimes somebody with a login here.
  responsibleParty String?
  /// Follow-up date, expected resolution, or expected resume date.
  dueAt DateTime?
  /// Which round of revisions this is, when that is what was raised.
  round Int?

  raisedById String?
  raisedAt   DateTime @default(now())

  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  raisedBy   User?  @relation("JourneyFlagRaiser", fields: [raisedById], references: [id], onDelete: SetNull)
  resolvedBy User?  @relation("JourneyFlagResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([clientId, resolvedAt])
  @@index([kind])
  @@index([dueAt])
}
