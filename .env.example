# Copy this file to .env.local and replace every placeholder with a real value.
# Never commit real credentials. This template must contain placeholders only.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exalted_media_agency?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/exalted_media_agency?schema=public"

# --- Authentication ---------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Initial workspace bootstrap --------------------------------------------
# Used only when the default agency users do not exist yet.
DEFAULT_ADMIN_PASSWORD="replace-with-a-secure-admin-password"
DEFAULT_MANAGER_PASSWORD="replace-with-a-secure-manager-password"

# Set to "true" only when you intentionally want `npm run db:seed` to reset the
# default users' passwords back to the values above. Leave unset otherwise so
# reseeding never overwrites a password someone has since changed.
# RESET_DEFAULT_USER_PASSWORDS="false"
# --- Staging / UAT ----------------------------------------------------------
# Human UAT runs against its own database, so testers and automated tests
# cannot reach each other's data. Copy this block into .env.uat (git-ignored)
# and point it at that database, then:
#
#   npm run uat:migrate     apply migrations
#   npm run uat:seed        configuration, SOPs, the 44 UAT cases, six seats
#   npm run uat:verify      prove every seat can actually sign in
#   npm run uat:dev         run the app against UAT on port 3100
#
# Set EVERY connection variable, not just DATABASE_URL. prisma.config.ts
# resolves DIRECT_URL before DATABASE_URL and dotenv fills in whatever is
# unset, so setting one and leaving the rest points half the tooling back at
# development - quietly, and with a success message. scripts/uat.mjs refuses to
# run when they disagree, but the fix is to set them all here.
#
# UAT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exalted_uat?schema=public"
# DIRECT_URL / PRISMA_DATABASE_URL / POSTGRES_URL / POSTGRES_URL_NON_POOLING
#   -> the same value as DATABASE_URL
# NEXTAUTH_URL="http://localhost:3100"
# AUTH_SECRET / CRON_SECRET  -> values of their own, never the production ones
#
# The password the six UAT seats are created with. Generate a real one; it is
# never committed, and it lives only in .env.uat.
# TEAM_SEED_PASSWORD="replace-with-a-generated-password"
