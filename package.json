{
  "name": "exalted-media-agency",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:with-db-sync": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.test --import ./tests/setup/assert-test-database.mjs --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed-team": "node scripts/seed-team.mjs",
    "db:seed-env": "node --import tsx scripts/seed-environment.ts",
    "uat:identity": "node scripts/uat.mjs identity",
    "uat:migrate": "node scripts/uat.mjs migrate",
    "uat:seed": "node scripts/uat.mjs seed",
    "uat:clients": "node scripts/uat.mjs clients",
    "uat:verify": "node scripts/uat.mjs verify",
    "uat:dev": "node scripts/uat.mjs dev",
    "uat:start": "node scripts/uat.mjs start",
    "uat:build": "node scripts/uat.mjs build",
    "db:studio": "prisma studio",
    "db:bootstrap": "prisma db push && prisma db seed",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:inventory": "node --import tsx scripts/inventory.ts",
    "db:sample": "node --import tsx scripts/seed-sample-data.ts",
    "test:migrate": "node --env-file=.env.test node_modules/prisma/build/index.js migrate deploy",
    "test:seed": "node --env-file=.env.test --import tsx scripts/seed-environment.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/manrope": "^5.2.8",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.3",
    "next-auth": "^4.24.13",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "prisma": "^7.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
